{
  "name": "animforge-core",
  "version": "0.1.0",
  "description": "AnimForge AI Core Orchestration Engine",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "animforge-mcp": "dist/src/mcp/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/character/engine/rigby', 'dist/src/character/engine/rigby', { recursive: true })\"",
    "mcp:start": "node dist/src/mcp/index.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "test:integration": "tsc && ANIMFORGE_INTEGRATION=1 node --test dist/test/*.integration.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.5"
  }
}
